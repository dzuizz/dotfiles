#!/usr/bin/env bash
# list scripts from dotfiles in following format:
# [script] \t [first comment line in script file]
set -euo pipefail

dir="$(cd "$(dirname "$0")" && pwd)"
self="$(basename "$0")"

printf '\033[1mscripts\033[0m (~/scripts)\n'
for f in "$dir"/*; do
  name="$(basename "$f")"
  [ -f "$f" ] || continue
  [ -x "$f" ] || continue
  [ "$name" = "$self" ] && continue
  case "$name" in *.bak) continue ;; esac

  if [ -L "$f" ]; then
    desc="alias of $(basename "$(readlink "$f")")"
  else
    desc="$(awk '
      NR==1 && /^#!/ { next }
      /^[[:space:]]*$/ { next }
      /^[[:space:]]*#/  { sub(/^[[:space:]]*#+[[:space:]]?/, ""); print; exit }
      /^[[:space:]]*"""/ { sub(/^[[:space:]]*"""[[:space:]]?/, ""); print; exit }
      { exit }
    ' "$f")"
    [ -z "$desc" ] && desc="—"
  fi
  printf '  \033[36m%-12s\033[0m %.62s\n' "$name" "$desc"
done
